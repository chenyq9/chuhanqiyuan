<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶部独立工具区：AI、状态、自由、清空、新局、聊天、设置。 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="54dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvAiName"
                        android:layout_width="match_parent"
                        android:layout_height="18dp"
                        android:gravity="center"
                        android:text="AI 棋友"
                        android:textColor="@color/board_line"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/aiAvatar"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@drawable/ai_avatar_bg"
                        android:gravity="center"
                        android:text="AI"
                        android:textColor="@color/board_line"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTurnStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:gravity="center_vertical"
                    android:text="● 对方正在思考…"
                    android:textColor="@color/board_line"
                    android:textSize="11sp"
                    android:visibility="invisible" />
            </LinearLayout>

            <!-- 自由模式独立于消息发送区，采用与顶部工具一致的圆润样式。 -->
            <TextView
                android:id="@+id/btnFree"
                android:layout_width="54dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/free_mode_bg"
                android:gravity="center"
                android:text="自由"
                android:textColor="@color/board_line"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <ImageView
                android:id="@+id/btnClear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="清空棋盘"
                android:src="@android:drawable/ic_menu_delete" />

            <ImageView
                android:id="@+id/btnNew"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="@string/new_game"
                android:src="@android:drawable/ic_menu_rotate" />

            <ImageView
                android:id="@+id/btnChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="@string/chat_history"
                android:src="@android:drawable/ic_menu_recent_history" />

            <ImageView
                android:id="@+id/btnCfg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="@string/settings"
                android:src="@android:drawable/ic_menu_preferences" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/capturedTopScroll"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/capturedTopArea"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <com.chuhanyuan.xiangqi.BoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center" />

        <!-- 被吃/放置区现在由布局真正占位，不再被聊天输入框盖住。 -->
        <HorizontalScrollView
            android:id="@+id/capturedScroll"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/capturedArea"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <!-- 输入行独占自己的空间；右侧永远只有发送按钮。 -->
        <LinearLayout
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="4dp">

            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hint="@string/say_something"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:inputType="textShortMessage" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="54dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:layout_marginStart="6dp"
                android:text="@string/send"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="58dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bubble_bg"
        android:maxLines="4"
        android:ellipsize="end"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="@color/board_line"
        android:textSize="14sp"
        android:visibility="gone"
        android:clickable="false" />

    <TextView
        android:id="@+id/tvEat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="吃"
        android:textSize="58sp"
        android:textStyle="bold"
        android:textColor="@color/board_line"
        android:visibility="gone"
        android:clickable="false" />
</FrameLayout>
