<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 工具栏占自己的空间，不再覆盖棋盘。 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical|end"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/btnNew"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="@string/new_game"
                android:src="@android:drawable/ic_menu_rotate" />

            <ImageView
                android:id="@+id/btnChat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="@string/chat_history"
                android:src="@android:drawable/ic_menu_recent_history" />

            <ImageView
                android:id="@+id/btnCfg"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="3dp"
                android:background="@drawable/bubble_bg"
                android:padding="8dp"
                android:contentDescription="@string/settings"
                android:src="@android:drawable/ic_menu_preferences" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/capturedTopScroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/capturedTopArea"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>

        <com.chuhanyuan.xiangqi.BoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center" />

        <HorizontalScrollView
            android:id="@+id/capturedScroll"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/capturedArea"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:paddingStart="8dp"
                android:paddingEnd="8dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="58dp"
        android:layout_marginStart="64dp"
        android:layout_marginEnd="64dp"
        android:background="@drawable/bubble_bg"
        android:maxLines="4"
        android:ellipsize="end"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp"
        android:textColor="@color/board_line"
        android:textSize="14sp"
        android:visibility="gone"
        android:clickable="false" />

    <TextView
        android:id="@+id/tvEat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="吃"
        android:textSize="58sp"
        android:textStyle="bold"
        android:textColor="@color/board_line"
        android:visibility="gone"
        android:clickable="false" />

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:clickable="false">

        <TextView
            android:id="@+id/tvTurnStatus"
            android:layout_width="wrap_content"
            android:layout_height="20dp"
            android:gravity="center_vertical"
            android:text="● 对方正在思考…"
            android:textColor="@color/board_line"
            android:textSize="12sp"
            android:visibility="gone"
            android:paddingStart="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <EditText
                android:id="@+id/etInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="@string/say_something"
                android:textSize="14sp"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:inputType="textShortMessage" />
            <Button
                android:id="@+id/btnFree"
                android:layout_width="54dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:layout_marginStart="5dp"
                android:text="自由"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnSend"
                android:layout_width="50dp"
                android:layout_height="40dp"
                android:minWidth="0dp"
                android:layout_marginStart="5dp"
                android:text="@string/send"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
