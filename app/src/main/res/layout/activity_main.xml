<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <HorizontalScrollView
            android:id="@+id/capturedTopScroll"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/capturedTopArea"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>

        <com.chuhanyuan.xiangqi.BoardView
            android:id="@+id/boardView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_gravity="center_horizontal" />

        <HorizontalScrollView
            android:id="@+id/capturedScroll"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/capturedArea"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginStart="56dp"
        android:layout_marginEnd="56dp"
        android:background="@drawable/bubble_bg"
        android:maxLines="4"
        android:ellipsize="end"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/board_line"
        android:textSize="15sp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/btnNew"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="10dp"
        android:background="@drawable/bubble_bg"
        android:padding="8dp"
        android:contentDescription="@string/new_game"
        android:src="@android:drawable/ic_menu_rotate" />

    <ImageView
        android:id="@+id/btnCfg"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="58dp"
        android:background="@drawable/bubble_bg"
        android:padding="8dp"
        android:contentDescription="@string/settings"
        android:src="@android:drawable/ic_menu_preferences" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <EditText
            android:id="@+id/etInput"
            android:layout_width="160dp"
            android:layout_height="wrap_content"
            android:hint="@string/say_something"
            android:textSize="13sp"
            android:maxLines="1"
            android:inputType="textShortMessage" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/send"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>